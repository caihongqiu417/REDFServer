<?xml version="1.0" encoding="UTF-8"?>
<!--
  配色方案：浅冷灰背景 + 品牌红点缀
    背景族  → 浅冷灰（带极少量蓝调，避免偏黄），不刺眼
    红色族  → #DC2E2E (0.86, 0.18, 0.18)，比正红稍亮，在灰底上清晰
    文字    → 近黑 (0.10, 0.10, 0.12)，高对比
    边框    → 中性灰，不带红，让红色只出现在交互元素上
-->
<theme name="CoolGrayRed">

  <!-- ============ 风格参数 ============ -->
  <style>
    <float name="WindowRounding"    value="8.0"/>
    <float name="ChildRounding"     value="6.0"/>
    <float name="FrameRounding"     value="6.0"/>
    <float name="PopupRounding"     value="6.0"/>
    <float name="ScrollbarRounding" value="10.0"/>
    <float name="GrabRounding"      value="6.0"/>
    <float name="TabRounding"       value="6.0"/>
    <float name="WindowBorderSize"  value="1.0"/>
    <float name="ChildBorderSize"   value="1.0"/>
    <float name="PopupBorderSize"   value="1.0"/>
    <float name="FrameBorderSize"   value="0.0"/>
    <float name="ScrollbarSize"     value="10.0"/>
    <float name="GrabMinSize"       value="10.0"/>
    <float name="IndentSpacing"     value="22.0"/>

    <vec2 name="WindowPadding"    x="15.0" y="15.0"/>
    <vec2 name="FramePadding"     x="12.0" y="6.0"/>
    <vec2 name="ItemSpacing"      x="12.0" y="8.0"/>
    <vec2 name="ItemInnerSpacing" x="10.0" y="6.0"/>
    <vec2 name="WindowTitleAlign" x="0.5"  y="0.5"/>
  </style>

  <!-- ============ 颜色 ============ -->
  <colors>

    <!-- ── 文字 ────────────────────────────────── -->
    <color name="Text"           r="0.10" g="0.10" b="0.12" a="1.00"/>
    <color name="TextDisabled"   r="0.60" g="0.61" b="0.63" a="1.00"/>
    <color name="TextSelectedBg" r="0.86" g="0.18" b="0.18" a="0.20"/>

    <!-- ── 窗口背景：浅冷灰 ──────────────────── -->
    <color name="WindowBg"  r="0.89" g="0.90" b="0.91" a="1.00"/>
    <color name="ChildBg"   r="0.92" g="0.93" b="0.94" a="1.00"/>
    <color name="PopupBg"   r="0.86" g="0.87" b="0.88" a="0.98"/>

    <!-- ── 顶部菜单栏 ─────────────────────────── -->
    <color name="MenuBarBg" r="0.88" g="0.89" b="0.90" a="1.00"/>

    <!-- ── 边框：中性灰，不带红 ──────────────── -->
    <color name="Border"       r="0.74" g="0.75" b="0.76" a="0.50"/>
    <color name="BorderShadow" r="0.00" g="0.00" b="0.00" a="0.00"/>

    <!-- ── 输入框/帧 ──────────────────────────── -->
    <color name="FrameBg"        r="0.88" g="0.89" b="0.90" a="1.00"/>
    <color name="FrameBgHovered" r="0.84" g="0.85" b="0.86" a="1.00"/>
    <color name="FrameBgActive"  r="0.80" g="0.81" b="0.82" a="1.00"/>

    <!-- ── 标题栏：灰底 + 激活时红色 ─────────── -->
    <color name="TitleBg"          r="0.87" g="0.88" b="0.89" a="1.00"/>
    <color name="TitleBgActive"    r="0.86" g="0.18" b="0.18" a="1.00"/>
    <color name="TitleBgCollapsed" r="0.89" g="0.90" b="0.91" a="0.90"/>

    <!-- ── 滚动条：灰轨 + 灰滑块，Hover/Active 变红 -->
    <color name="ScrollbarBg"          r="0.91" g="0.92" b="0.93" a="1.00"/>
    <color name="ScrollbarGrab"        r="0.73" g="0.74" b="0.75" a="1.00"/>
    <color name="ScrollbarGrabHovered" r="0.86" g="0.18" b="0.18" a="0.50"/>
    <color name="ScrollbarGrabActive"  r="0.86" g="0.18" b="0.18" a="0.85"/>

    <!-- ── 勾选 / 滑块 ───────────────────────── -->
    <color name="CheckMark"        r="0.86" g="0.18" b="0.18" a="1.00"/>
    <color name="SliderGrab"       r="0.86" g="0.18" b="0.18" a="0.75"/>
    <color name="SliderGrabActive" r="0.92" g="0.22" b="0.22" a="0.90"/>

    <!-- ── 按钮：实心红，三态 ────────────────── -->
    <color name="Button"        r="0.86" g="0.18" b="0.18" a="0.85"/>
    <color name="ButtonHovered" r="0.92" g="0.22" b="0.22" a="0.95"/>
    <color name="ButtonActive"  r="0.78" g="0.14" b="0.14" a="1.00"/>

    <!-- ── 列表/树节点头 ──────────────────────── -->
    <color name="Header"        r="0.86" g="0.18" b="0.18" a="0.70"/>
    <color name="HeaderHovered" r="0.90" g="0.22" b="0.22" a="0.80"/>
    <color name="HeaderActive"  r="0.95" g="0.15" b="0.15" a="0.90"/>

    <!-- ── 分隔线：灰色，Hover/Active 变红 ───── -->
    <color name="Separator"        r="0.74" g="0.75" b="0.76" a="0.50"/>
    <color name="SeparatorHovered" r="0.86" g="0.18" b="0.18" a="0.60"/>
    <color name="SeparatorActive"  r="0.86" g="0.18" b="0.18" a="0.90"/>

    <!-- ── 缩放把手 ────────────────────────────── -->
    <color name="ResizeGrip"        r="0.86" g="0.18" b="0.18" a="0.15"/>
    <color name="ResizeGripHovered" r="0.86" g="0.18" b="0.18" a="0.50"/>
    <color name="ResizeGripActive"  r="0.86" g="0.18" b="0.18" a="0.85"/>

    <!-- ── 标签页 ─────────────────────────────── -->
    <color name="Tab"               r="0.89" g="0.90" b="0.91" a="1.00"/>
    <color name="TabHovered"        r="0.86" g="0.18" b="0.18" a="0.50"/>
    <color name="TabActive"         r="0.86" g="0.18" b="0.18" a="0.85"/>
    <color name="TabUnfocused"      r="0.91" g="0.92" b="0.93" a="1.00"/>
    <color name="TabUnfocusedActive" r="0.86" g="0.18" b="0.18" a="0.40"/>

    <!-- ── 图表 ──────────────────────────────── -->
    <color name="PlotLines"            r="0.86" g="0.18" b="0.18" a="1.00"/>
    <color name="PlotLinesHovered"     r="0.92" g="0.22" b="0.22" a="1.00"/>
    <color name="PlotHistogram"        r="0.86" g="0.18" b="0.18" a="1.00"/>
    <color name="PlotHistogramHovered" r="0.92" g="0.22" b="0.22" a="1.00"/>

    <!-- ── 表格 ──────────────────────────────── -->
    <color name="TableHeaderBg"     r="0.91" g="0.92" b="0.93" a="1.00"/>
    <color name="TableBorderStrong" r="0.74" g="0.75" b="0.76" a="1.00"/>
    <color name="TableBorderLight"  r="0.82" g="0.83" b="0.84" a="1.00"/>
    <color name="TableRowBg"        r="0.00" g="0.00" b="0.00" a="0.00"/>
    <color name="TableRowBgAlt"     r="0.91" g="0.92" b="0.93" a="1.00"/>

    <!-- ── 其他 ──────────────────────────────── -->
    <color name="DragDropTarget"        r="0.86" g="0.18" b="0.18" a="0.85"/>
    <color name="NavHighlight"          r="0.86" g="0.18" b="0.18" a="1.00"/>
    <color name="NavWindowingHighlight" r="1.00" g="1.00" b="1.00" a="0.70"/>
    <color name="NavWindowingDimBg"     r="0.20" g="0.20" b="0.20" a="0.20"/>
    <color name="ModalWindowDimBg"      r="0.20" g="0.20" b="0.20" a="0.35"/>

  </colors>

</theme>
